# Godot 4+ specific ignores
.godot/
/android/
export_presets.cfg
/build/
/export/

# Python (tools/)
__pycache__/
*.py[cod]
.venv/
.uv-cache/

# Аудио-промежуточные файлы (в репо кладём только .ogg)
tools/**/*.wav
tools/**/out/

# Арт-промежуточные файлы. В репо попадает только принятое (art/<вид>/)
# и решения по нему — сами кандидаты воспроизводятся прогоном по манифесту:
# сид детерминирован, тот же чекпойнт даёт те же картинки.
art/candidates/
art/raw/
art/review/*.png
art/review/gallery.html

# ОС и редакторы
Thumbs.db
.DS_Store
.vscode/
.idea/

# Claude Code — локальные переопределения
.claude/settings.local.json
