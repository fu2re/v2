class_name NoteRules
extends RefCounted

## Какая кнопка какую ноту принимает (GDD §4.2).
##
## Низ экрана поделён надвое: правая половина — обычный бит, левая — особый.
## Больше целей нет, и это сознательное упрощение ради младшей аудитории:
## игрок думает про «когда» и про один бинарный выбор «обычное или особое»,
## а не про «куда попасть».
##
## Соответствие «тип ноты → кнопка» задано ДИЗАЙНОМ, а не чартом, поэтому
## вычисляется здесь и не хранится в файлах: иначе триста уже сгенерированных
## чартов пришлось бы переписывать ради информации, которая и так известна.

enum Lane { NORMAL, SPECIAL }

const LANE_NAMES := {
	Lane.NORMAL: "Бит",
	Lane.SPECIAL: "Особая",
}


## На какой дорожке нота падает и какой кнопкой берётся по умолчанию.
##
## Обычный бит — единственная нота правой кнопки. Всё остальное требует
## особого внимания и потому уходит влево.
static func primary_lane(type: int) -> int:
	match type:
		ChartData.NoteType.BEAT:
			return Lane.NORMAL
		_:
			return Lane.SPECIAL


## Принимает ли нота нажатие этой кнопки.
##
## Ни одна нота больше не принимает обе кнопки. Такой была нота-зелье —
## особой выпить, обычной сберечь, — но зелий в игре нет: лечение переехало
## к костру, где выбор «лечиться или беречь угощение» принимается спокойно,
## а не за долю секунды в ритме (GDD §8.2.3).
##
## Атаки монстра — обычная (щит) и тяжёлая — альтернативы НЕ имеют:
## прожал особую кнопку — блок, прожал обычную или промолчал — удар дошёл.
static func accepts(type: int, lane: int) -> bool:
	return primary_lane(type) == lane


static func lane_name(lane: int) -> String:
	return LANE_NAMES.get(lane, "?")
