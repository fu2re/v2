extends Node

## Точка входа. Решает, куда отправить игрока при запуске.
##
## Отдельная сцена нужна, чтобы автозагрузчики успели прочитать сейв:
## решение «обучение или ферма» зависит от него, а порядок готовности
## автозагрузчиков и главной сцены иначе становится неявным.

func _ready() -> void:
	# Один кадр, чтобы _ready всех автозагрузчиков точно отработал
	await get_tree().process_frame
	get_tree().change_scene_to_file(OnboardingState.entry_scene())
