[resource]
default_font_size = 32

; --- Кнопка. Ростом не ниже 120: детский палец промахивается по мелкому,
; --- а промах в меню читается ребёнком как «игра сломалась».
Button/colors/font_color = Color(0.941, 0.871, 0.753, 1)
Button/colors/font_hover_color = Color(1, 0.965, 0.898, 1)
Button/colors/font_pressed_color = Color(0.949, 0.816, 0.416, 1)
Button/colors/font_focus_color = Color(1, 0.965, 0.898, 1)
Button/colors/font_disabled_color = Color(0.573, 0.529, 0.478, 0.75)
Button/colors/font_outline_color = Color(0.055, 0.043, 0.031, 1)
Button/constants/outline_size = 0
Button/constants/h_separation = 16
Button/font_sizes/font_size = 34
Button/styles/normal = SubResource("btn_normal")
Button/styles/hover = SubResource("btn_hover")
Button/styles/pressed = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus = SubResource("btn_focus")

; --- Подпись. Обводка ВСЕГДА: подписи лежат на пёстром лесу и во дворе,
; --- и без неё буквы теряются в траве. Это не украшение, а читаемость.
Label/colors/font_color = Color(0.941, 0.871, 0.753, 1)
Label/colors/font_outline_color = Color(0.055, 0.043, 0.031, 1)
Label/colors/font_shadow_color = Color(0, 0, 0, 0)
Label/constants/outline_size = 8
Label/constants/line_spacing = 6
Label/font_sizes/font_size = 32

RichTextLabel/colors/default_color = Color(0.941, 0.871, 0.753, 1)
RichTextLabel/colors/font_outline_color = Color(0.055, 0.043, 0.031, 1)
RichTextLabel/constants/outline_size = 8
RichTextLabel/constants/line_separation = 6
RichTextLabel/font_sizes/normal_font_size = 32

Panel/styles/panel = SubResource("panel")
PanelContainer/styles/panel = SubResource("panel_card")
PopupPanel/styles/panel = SubResource("panel")

TooltipPanel/styles/panel = SubResource("tooltip")
TooltipLabel/font_sizes/font_size = 28

; --- Прокрутка. Полоска толще дефолтной: ею целятся пальцем, а не мышью.
VScrollBar/styles/scroll = SubResource("scroll_bg")
VScrollBar/styles/grabber = SubResource("scroll_grabber")
VScrollBar/styles/grabber_highlight = SubResource("scroll_grabber_hl")
VScrollBar/styles/grabber_pressed = SubResource("scroll_grabber_hl")
HScrollBar/styles/scroll = SubResource("scroll_bg")
HScrollBar/styles/grabber = SubResource("scroll_grabber")
HScrollBar/styles/grabber_highlight = SubResource("scroll_grabber_hl")
HScrollBar/styles/grabber_pressed = SubResource("scroll_grabber_hl")
ScrollContainer/styles/panel = SubResource("empty")

ProgressBar/styles/background = SubResource("bar_bg")
ProgressBar/styles/fill = SubResource("bar_fill")
ProgressBar/colors/font_color = Color(0.941, 0.871, 0.753, 1)
ProgressBar/colors/font_outline_color = Color(0.055, 0.043, 0.031, 1)
ProgressBar/constants/outline_size = 6

LineEdit/styles/normal = SubResource("line_edit")
LineEdit/styles/focus = SubResource("btn_focus")
LineEdit/colors/font_color = Color(0.941, 0.871, 0.753, 1)
LineEdit/font_sizes/font_size = 32

HSeparator/styles/separator = SubResource("separator")
VSeparator/styles/separator = SubResource("separator")

BoxContainer/constants/separation = 18
VBoxContainer/constants/separation = 18
HBoxContainer/constants/separation = 18
GridContainer/constants/h_separation = 18
